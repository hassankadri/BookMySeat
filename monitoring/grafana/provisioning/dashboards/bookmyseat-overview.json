
{
  "uid": "bookmyseat-operations",
  "title": "BookMySeat | Operations",
  "description": "Backend performance, infrastructure health and booking lifecycle monitoring.",
  "tags": ["bookmyseat", "operations", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Backend availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "up{job=\"bookmyseat-backend\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "DOWN", "color": "red"},
                "1": {"text": "UP", "color": "green"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "MongoDB connection",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "bookmyseat_mongodb_up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "DOWN", "color": "red"},
                "1": {"text": "UP", "color": "green"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Redis connection",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "bookmyseat_redis_up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "DOWN", "color": "red"},
                "1": {"text": "UP", "color": "green"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Firing alerts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(ALERTS{alertstate=\"firing\",alertname=~\"BookMySeat.*\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "API requests per second",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 0, "y": 4, "w": 8, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(bookmyseat_http_requests_total{route!=\"/api/metrics\"}[5m])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps", "decimals": 2},
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "title": "HTTP 5xx error rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 8, "y": 4, "w": 8, "h": 4},
      "targets": [
        {
          "expr": "(100 * sum(rate(bookmyseat_http_requests_total{route!=\"/api/metrics\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(bookmyseat_http_requests_total{route!=\"/api/metrics\"}[5m])), 0.001)) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 2},
              {"color": "red", "value": 5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 7,
      "title": "API latency p95",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 16, "y": 4, "w": 8, "h": 4},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bookmyseat_http_request_duration_seconds_bucket{route!=\"/api/metrics\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 2}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 8,
      "title": "Request throughput by HTTP status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (status_code) (rate(bookmyseat_http_requests_total{route!=\"/api/metrics\"}[5m]))",
          "legendFormat": "HTTP {{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 9,
      "title": "API response latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(bookmyseat_http_request_duration_seconds_bucket{route!=\"/api/metrics\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bookmyseat_http_request_duration_seconds_bucket{route!=\"/api/metrics\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 10,
      "title": "Service health history",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "up{job=\"bookmyseat-backend\"}",
          "legendFormat": "Backend",
          "refId": "A"
        },
        {
          "expr": "bookmyseat_mongodb_up",
          "legendFormat": "MongoDB",
          "refId": "B"
        },
        {
          "expr": "bookmyseat_redis_up",
          "legendFormat": "Redis",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 11,
      "title": "Backend memory usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "bookmyseat_process_resident_memory_bytes",
          "legendFormat": "Resident memory",
          "refId": "A"
        },
        {
          "expr": "bookmyseat_nodejs_heap_size_used_bytes",
          "legendFormat": "V8 heap used",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes"},
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      }
    },
    {
      "id": 12,
      "title": "Seat lock events — last hour",
      "description": "Requires the seat-lock service to increment the existing event counter.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 0, "y": 24, "w": 8, "h": 7},
      "targets": [
        {
          "expr": "sum by (event) (increase(bookmyseat_seat_lock_events_total[1h]))",
          "legendFormat": "{{event}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0},
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 13,
      "title": "Booking events — last hour",
      "description": "Requires booking lifecycle handlers to increment the existing event counter.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 8, "y": 24, "w": 8, "h": 7},
      "targets": [
        {
          "expr": "sum by (event) (increase(bookmyseat_booking_events_total[1h]))",
          "legendFormat": "{{event}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0},
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 14,
      "title": "Payment events — last hour",
      "description": "Requires payment and signed webhook handlers to increment the existing event counter.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "bookmyseat-prometheus"
      },
      "gridPos": {"x": 16, "y": 24, "w": 8, "h": 7},
      "targets": [
        {
          "expr": "sum by (event) (increase(bookmyseat_payment_events_total[1h]))",
          "legendFormat": "{{event}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0},
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    }
  ]
}
